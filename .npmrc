# onnxruntime-node (pulled in by kokoro-js and @huggingface/transformers) tries
# to download CUDA GPU binaries from GitHub when installed on Linux x64. That
# download now returns 404 and fails `npm ci` on CI and Vercel. The patient
# voice runs in the browser, so the GPU binaries are never used.
onnxruntime-node-install-cuda=skip
onnxruntime-node-install=skip
